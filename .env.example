# Copy to .env for LOCAL runs only. Never commit .env.
# In the cloud these values are set by template.yaml (secrets as NoEcho parameters, encrypted by Lambda at rest).

# AI provider for the accurate level: bedrock (default in the cloud), gemini, or mock (offline tests)
AI_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
# Claude Sonnet 4.6 inference profile ID for your region (deploy.sh finds and prints it)
BEDROCK_MODEL_ID=
# only if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# AWS (local runs use your own credentials from `aws configure` or the SSO portal, not this file)
AWS_REGION=us-east-1
TEXTRACT_REGION=us-east-1

# Optional witness: Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Engine limits
JOB_BUDGET_SECONDS=780
AI_BUDGET_SECONDS=60
AI_PARALLEL=4
MAX_PAGES=150
WITNESSES=pypdf,markitdown,textract
